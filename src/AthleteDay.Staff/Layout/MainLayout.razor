@inherits LayoutComponentBase
@implements IDisposable
@inject PersonaState Persona

<header class="topbar">
    <div class="brand">
        <span class="brand-mark" aria-hidden="true"></span>
        <div>
            <strong>Athlete Day</strong>
            <span class="brand-sub">@L["BrandSub"]</span>
        </div>
    </div>
    <div class="topbar-right">
        <label class="persona">
            <span>@L["SignedInAs"]</span>
            @* A signed-in athlete still shows as the "Athlete" entry; the second list says which one. *@
            <select value="@(Persona.Is(Roles.Athlete) ? PersonaState.AthleteChooser : Persona.Current.User)"
                    @onchange="e => Persona.Switch(e.Value!.ToString()!)">
                @foreach (var p in PersonaState.All)
                {
                    <option value="@p.User">@L[$"Persona_{p.User}"]</option>
                }
            </select>
        </label>
        <AthleteSignIn />
        <LanguageSwitch />
    </div>
</header>

<nav class="tabs" aria-label="@L["NavLabel"]">
    <NavLink href="" Match="NavLinkMatch.All">@L["NavOverview"]</NavLink>
    @if (Persona.Is(Roles.Coach)) { <NavLink href="sessions/new">@L["NavLogSession"]</NavLink> }
    @if (Persona.Is(Roles.Athlete)) { <NavLink href="wellness">@L["NavMorningCheck"]</NavLink> }
    @if (Persona.Is(Roles.Nutrition)) { <NavLink href="nutrition">@L["NavNutrition"]</NavLink> }
    @if (Persona.Is(Roles.Physio)) { <NavLink href="physio">@L["NavPhysio"]</NavLink> }
</nav>

<main class="page">
    @Body
</main>

<footer class="foot">@L["Footer"]</footer>

@code {
    protected override void OnInitialized() => Persona.Changed += OnPersonaChanged;

    private void OnPersonaChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Persona.Changed -= OnPersonaChanged;
}
