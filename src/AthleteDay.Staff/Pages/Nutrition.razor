@page "/nutrition"
@inject StaffApi Api

<PageTitle>@L["PageTitle", L["NavNutrition"]]</PageTitle>

<RoleGate Role="@Roles.Nutrition">
    <h1>@L["NutritionTitle"]</h1>
    <p class="lead">@L["NutritionLead"]</p>

    <EditForm Model="_model" OnValidSubmit="SubmitAsync" FormName="nutrition" class="form">
        <DataAnnotationsValidator />
        <ServerValidator @ref="_server" />

        <AthletePicker @bind-Value="_model.AthleteId" />

        <div class="row">
            <label>
                @L["Date"]
                <InputDate @bind-Value="_model.Date" />
                <ValidationMessage For="() => _model.Date" />
            </label>
            <label>
                @L["EnergyKcal"]
                <InputNumber @bind-Value="_model.EnergyKcal" step="50" />
                <ValidationMessage For="() => _model.EnergyKcal" />
            </label>
            <label>
                @L["CarbsPerKg"]
                <InputNumber @bind-Value="_model.CarbsGPerKg" step="0.5" />
                <ValidationMessage For="() => _model.CarbsGPerKg" />
            </label>
        </div>

        <label>
            @L["KitchenNote"]
            <InputText @bind-Value="_model.KitchenNote" placeholder="@L["KitchenNotePlaceholder"]" />
            <ValidationMessage For="() => _model.KitchenNote" />
        </label>

        <div class="actions">
            <span></span>
            <button type="submit" disabled="@_busy">@L["SaveTarget"]</button>
        </div>
    </EditForm>

    <ResultBanner Error="@_error" Success="@_success" />
</RoleGate>

@code {
    private readonly NutritionTargetRequest _model = new();
    private ServerValidator? _server;
    private bool _busy;
    private string? _error;
    private string? _success;

    private async Task SubmitAsync()
    {
        _busy = true;
        _error = _success = null;
        var result = await Api.SetNutritionAsync(_model);
        _busy = false;

        if (result.FieldErrors is { } errors) _server!.Show(errors);
        else if (result.Error is { } error) _error = error;
        else _success = L["TargetSaved", result.Value!.EnergyKcal, result.Value.CarbsG];
    }
}
