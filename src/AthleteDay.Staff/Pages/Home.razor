@page "/"
@implements IDisposable
@inject PersonaState Persona

<PageTitle>@L["PageTitle", L["BrandSub"]]</PageTitle>

<h1>@L["HomeTitle"]</h1>
<p class="lead">@L["HomeLead"]</p>

<div class="cards">
    <a class="card @(Persona.Is(Roles.Coach) ? "active" : "")" href="sessions/new" @onclick="() => Persona.Switch(PersonaFor(Roles.Coach))">
        <h2>@L["Role_Coach"]</h2>
        <p>@L["CardCoachText"]</p>
    </a>
    <a class="card @(Persona.Is(Roles.Athlete) ? "active" : "")" href="wellness" @onclick="() => Persona.Switch(PersonaFor(Roles.Athlete))">
        <h2>@L["Role_Athlete"]</h2>
        <p>@L["CardAthleteText"]</p>
    </a>
    <a class="card @(Persona.Is(Roles.Nutrition) ? "active" : "")" href="nutrition" @onclick="() => Persona.Switch(PersonaFor(Roles.Nutrition))">
        <h2>@L["Role_Nutrition"]</h2>
        <p>@L["CardNutritionText"]</p>
    </a>
    <a class="card @(Persona.Is(Roles.Physio) ? "active" : "")" href="physio" @onclick="() => Persona.Switch(PersonaFor(Roles.Physio))">
        <h2>@L["Role_Physio"]</h2>
        <p>@L["CardPhysioText"]</p>
    </a>
</div>

@if (Persona.Is(Roles.Kitchen))
{
    <p class="notice">@L["KitchenNotice"]</p>
}

@code {
    private static string PersonaFor(string role) => PersonaState.All.First(p => p.Role == role).User;

    protected override void OnInitialized() => Persona.Changed += OnPersonaChanged;

    private void OnPersonaChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Persona.Changed -= OnPersonaChanged;
}
