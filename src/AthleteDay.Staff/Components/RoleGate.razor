@implements IDisposable
@inject PersonaState Persona

@if (Persona.Is(Role))
{
    @ChildContent
}
else
{
    <div class="notice">
        <strong>@L["NotForRole", L[$"Role_{Persona.Current.Role}"]]</strong>
        @L["RoleGateText", L[$"Role_{Role}"]]
    </div>
}

@code {
    [Parameter, EditorRequired] public string Role { get; set; } = "";
    [Parameter] public RenderFragment? ChildContent { get; set; }

    protected override void OnInitialized() => Persona.Changed += OnPersonaChanged;

    private void OnPersonaChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Persona.Changed -= OnPersonaChanged;
}
